<Ui>
    <Frame name="LettuceTrackerLootFrameButtons" virtual="true">
        <Size x="308" y="32"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Bg">
                    <Anchors>
                        <Anchor point="TOPLEFT"/>
                        <Anchor point="BOTTOMRIGHT"/>
                    </Anchors>
                    <Color r="1" g="1" b="1" a="0.04"/>
                </Texture>
            </Layer>
            <Layer level="OVERLAY">
                <Texture name="$parentIcon" parentKey="Icon">
                    <Size x="28" y="28"/>
                    <Anchors>
                        <Anchor point="LEFT" x="6" y="0"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="NameText" inherits="GameFontHighlight" justifyH="LEFT">
                    <Size x="190" y="32"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeTo="$parentIcon" x="32" y="0"/>
                    </Anchors>
                </FontString>

                <FontString parentKey="CountText" inherits="GameFontHighlight" justifyH="RIGHT">
                    <Size x="48" y="32"/>
                    <Anchors>
                        <Anchor point="RIGHT" x="-8" y="0"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
</Ui>